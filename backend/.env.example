# Copie para .env e preencha. NUNCA commite o .env.
# String de conexão do Neon (Dashboard > Connection Details > "Connection string").
# Precisa terminar com ?sslmode=require
DATABASE_URL=postgresql://user:senha@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require

# Porta do backend em dev (o Vite faz proxy pra cá).
PORT=3001
